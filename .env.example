APP_NAME="Requisition Analyzer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
# The SPA is served by Laravel itself, so it shares APP_URL's origin (only change for a split deployment)
FRONTEND_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Business time zone used for all business dates and date presets (storage stays UTC)
BUSINESS_TIMEZONE=Asia/Dhaka

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
# Log queries slower than this many milliseconds to storage/logs/slow-queries.log
SLOW_QUERY_MS=500

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=requisition_analyzer
DB_USERNAME=req_analyzer
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production (HTTPS only)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# The app's own host:port always gets cookie (SPA) auth. List extra SPA origins here only for a split deployment (comma-separated host[:port])
SANCTUM_STATEFUL_DOMAINS=
# Mobile personal access token lifetime in minutes (null = never expires)
SANCTUM_EXPIRATION=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=req_analyzer_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# OCR for scanned PDFs: "tesseract" or "null" (disabled)
OCR_DRIVER=tesseract
TESSERACT_BINARY=tesseract
PDFTOPPM_BINARY=pdftoppm
PDFTOTEXT_BINARY=pdftotext
OCR_LANGUAGES=eng

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
REDIS_QUEUE_RETRY_AFTER=660
